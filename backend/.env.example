# SMARTPARK Environment Configuration

FLASK_APP=wsgi.py
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
AUTO_CREATE_SCHEMA=1
DB_CONNECT_TIMEOUT=10

FLASK_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_ADMIN_PASSWORD
IOT_AUTH_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_TOKEN

# Supabase project values. Keep all keys server-side; never put them in frontend JS.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=CHANGE_ME_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY

# Supabase PostgreSQL database URL.
# Copy the connection string from Supabase -> Connect.
# Example:
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# DATABASE_URL is also accepted by Render/other hosts.
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

RATE_COMPACT_BASE=20.00
RATE_COMPACT_HOURLY=20.00
RATE_SUV_BASE=30.00
RATE_SUV_HOURLY=30.00
RATE_TWO_WHEELER_BASE=10.00
RATE_TWO_WHEELER_HOURLY=10.00
RATE_EV_BASE=25.00
RATE_EV_HOURLY=25.00

CORS_ORIGINS=https://YOUR_VERCEL_DOMAIN.vercel.app
