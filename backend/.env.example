# SMARTPARK Environment Configuration

FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

FLASK_SECRET_KEY=CHANGE_ME
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# Supabase PostgreSQL database URL.
# Copy the connection string from Supabase -> Connect.
# Example:
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
SUPABASE_DB_URL=CHANGE_ME

# DATABASE_URL is also accepted by Render/other hosts.
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

RATE_COMPACT_BASE=20.00
RATE_COMPACT_HOURLY=20.00
RATE_SUV_BASE=30.00
RATE_SUV_HOURLY=30.00
RATE_TWO_WHEELER_BASE=10.00
RATE_TWO_WHEELER_HOURLY=10.00
RATE_EV_BASE=25.00
RATE_EV_HOURLY=25.00

IOT_AUTH_TOKEN=CHANGE_ME_IOT_TOKEN
CORS_ORIGINS=*
