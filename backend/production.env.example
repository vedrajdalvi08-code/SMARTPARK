# SMARTPARK production environment template
FLASK_APP=wsgi.py
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
AUTO_CREATE_SCHEMA=1
DB_CONNECT_TIMEOUT=10

FLASK_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_ADMIN_PASSWORD
IOT_AUTH_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_TOKEN

# Supabase project keys are server-side only. Never expose them to frontend JS.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=CHANGE_ME_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY

# Supabase PostgreSQL connection string.
# Get it from Supabase Dashboard -> Connect.
SUPABASE_DB_URL=CHANGE_ME

# DATABASE_URL can be used instead of SUPABASE_DB_URL.
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

RATE_COMPACT_BASE=20.00
RATE_COMPACT_HOURLY=20.00
RATE_SUV_BASE=30.00
RATE_SUV_HOURLY=30.00
RATE_TWO_WHEELER_BASE=10.00
RATE_TWO_WHEELER_HOURLY=10.00
RATE_EV_BASE=25.00
RATE_EV_HOURLY=25.00

CORS_ORIGINS=*
